---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CardPopups from '../../../components/cards/CardPopups';
import { formatChangeDisplay } from '../../../lib/changeFormatters';
import type { Page, PaginateFunction } from 'astro';
import { getMonthGroups, type MonthGroup } from '../../../lib/updates';

// Minimal card type for thumbnail lookups (cards_index.json doesn't have all Card fields)
interface CardIndexEntry {
  id: string;
  asset_id: string;
  name: string | null;
  images?: {
    android?: string | null;
    hd?: string | null;
  };
  image_urls?: {
    android?: string | null;
    hd?: string | null;
  };
}

// Load cards index for image lookups
let cardsIndex: Record<string, CardIndexEntry> = {};
try {
  const cardsData = await import('../../../../public/data/cards_index.json') as { default?: { cards?: Record<string, CardIndexEntry> }, cards?: Record<string, CardIndexEntry> };
  cardsIndex = (cardsData.default || cardsData).cards || {};
} catch (_e) {
  console.warn('Failed to load cards index for images');
}

// =============================================================================
// STANDARDIZED TRANSFORMS - Must match src/lib/images.ts to avoid duplicate credits
// =============================================================================
const CLOUDINARY_BASE = 'https://res.cloudinary.com/dn3j8sqcc/image/upload';
const TRANSFORMS = {
  // Android: serve at original size (~200px) - browser downscales nicely for retina
  androidCircle: 'c_scale,r_max,f_auto,q_auto',
  // HD circle: 120px (2x for retina) - high-res source so resize is crisp
  hdCircle: 'w_120,h_120,c_thumb,g_face,r_max,f_auto,q_auto',
} as const;

// Mascot placeholder - sad chibi for cards without images
const PLACEHOLDER_MASCOT_ID = 'v1765670264/mascot_p2e3gi.png';
const PLACEHOLDER_MASCOT_URL = `${CLOUDINARY_BASE}/w_60,h_60,c_fill,g_face,f_auto,q_auto/${PLACEHOLDER_MASCOT_ID}`;

// Get card thumbnail with proper fallback chain
// Android: original size (~200px) - CSS handles display size
// HD fallback: 120px circle (2x for retina)
function getCardThumbnail(cardId: string): string {
  const card = cardsIndex[cardId];
  if (!card) return PLACEHOLDER_MASCOT_URL;

  // 1. Try android image from image_urls
  const androidUrl = card.image_urls?.android;
  if (androidUrl) {
    if (androidUrl.includes('cloudinary.com')) {
      return androidUrl.replace('/upload/', `/upload/${TRANSFORMS.androidCircle}/`);
    }
    return androidUrl;
  }

  // 2. Try HD image from image_urls (generate circle from HD)
  const hdUrl = card.image_urls?.hd;
  if (hdUrl && hdUrl.includes('cloudinary.com')) {
    return hdUrl.replace('/upload/', `/upload/${TRANSFORMS.hdCircle}/`);
  }

  // 3. Mascot placeholder for cards without images
  return PLACEHOLDER_MASCOT_URL;
}

// Helper to format date
function formatDate(dateStr: string): string {
  if (!dateStr) return 'Unknown date';
  try {
    const date = new Date(dateStr);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  } catch {
    return dateStr;
  }
}

// Helper to render rarity stars
function renderStars(rarity: number): string {
  return '★'.repeat(Math.min(Math.max(rarity, 0), 5));
}

// ponytail: paginate whole months (2 per page) so the first page stays small.
// Page 1 keeps the /en/updates URL via the rest param.
export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  return paginate(await getMonthGroups(), { pageSize: 2 });
}

const { page } = Astro.props as { page: Page<MonthGroup> };
---

<BaseLayout title="Updates" description="Otogi Spirit Agents card patch notes - new cards and balance changes" hasLocalizedUrls={true}>
  <script is:inline>
    // Locale detection and link updating for updates page
    (function() {
      var SUPPORTED_LOCALES = ['en', 'ja', 'ko', 'zh-cn', 'zh-tw', 'es'];
      var STORAGE_KEY = 'otogidb-locale';

      function getStoredLocale() {
        try {
          var stored = localStorage.getItem(STORAGE_KEY);
          return stored && SUPPORTED_LOCALES.indexOf(stored) !== -1 ? stored : null;
        } catch (e) { return null; }
      }

      function getCurrentLocale() {
        var pathMatch = location.pathname.match(/^\/([a-z]{2}(?:-[a-z]{2})?)(\/|$)/);
        if (pathMatch && SUPPORTED_LOCALES.indexOf(pathMatch[1]) !== -1) {
          return pathMatch[1];
        }
        return getStoredLocale() || 'en';
      }

      function updateCardLinks() {
        var locale = getCurrentLocale();
        var prefix = '/' + locale;

        document.querySelectorAll('a[href^="/cards/"]').forEach(function(link) {
          var href = link.getAttribute('href');
          if (href) {
            var cardId = href.replace('/cards/', '');
            link.setAttribute('href', prefix + '/cards/' + cardId);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateCardLinks);
      } else {
        updateCardLinks();
      }

      window.addEventListener('otogidb-locale-change', function(e) {
        var locale = e.detail && e.detail.locale;
        if (!locale) return;
        var prefix = '/' + locale;
        document.querySelectorAll('a[href*="/cards/"]').forEach(function(link) {
          var href = link.getAttribute('href');
          if (href) {
            var match = href.match(/\/(?:[a-z]{2}(?:-[a-z]{2})?\/)?cards\/(\d+)/);
            if (match) {
              link.setAttribute('href', prefix + '/cards/' + match[1]);
            }
          }
        });
      });
    })();
  </script>
  <div class="container mx-auto px-4 py-6">
    <div class="mb-6">
      <h1 class="text-2xl md:text-3xl font-bold mb-2">Patch Notes</h1>
      <p class="text-secondary">Card updates, new releases, and balance changes.</p>
    </div>

    {page.data.length === 0 ? (
      <div class="card p-6 text-center">
        <p class="text-secondary">No patch notes available yet.</p>
      </div>
    ) : (
      <div class="space-y-6">
        {page.data.map((group, groupIndex) => (
          <details class="group" open={group.isCurrentMonth || groupIndex === 0}>
            <summary class="cursor-pointer p-4 bg-base-200 rounded-lg flex items-center justify-between hover:bg-base-300 transition-colors list-none [&::-webkit-details-marker]:hidden">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
                <span class="text-xl font-semibold">{group.label}</span>
              </div>
              <span class="badge badge-neutral">{group.updates.length} update{group.updates.length !== 1 ? 's' : ''}</span>
            </summary>

            <div class="mt-4 space-y-8">
              {group.updates.map((notes) => (
                <article id={notes.version} class="card overflow-hidden">
            {/* Header */}
            <div class="p-4 md:p-6 border-b" style="border-color: var(--color-border);">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
                <div>
                  {/* Date is the heading; the internal version identifier is not shown. */}
                  <h2 class="text-xl font-bold">{formatDate(notes.version_date)}</h2>
                </div>

                <div class="flex flex-wrap gap-2">
                  {notes.summary.new_cards > 0 && (
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium"
                          style="background-color: rgba(34, 197, 94, 0.15); color: rgb(34, 197, 94);">
                      +{notes.summary.new_cards} New
                    </span>
                  )}
                  {notes.summary.modified_cards > 0 && (
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium"
                          style="background-color: rgba(59, 130, 246, 0.15); color: rgb(59, 130, 246);">
                      {notes.summary.modified_cards} Changed
                    </span>
                  )}
                </div>
              </div>
            </div>

            <div class="p-4 md:p-6 space-y-6">
              {/* New Cards Section */}
              {notes.new_cards.length > 0 && (
                <section>
                  <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full" style="background-color: rgb(34, 197, 94);"></span>
                    New Cards
                  </h3>
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    {notes.new_cards.map((card) => (
                      <a href={`/en/cards/${card.id}`}
                         data-card-id={card.id}
                         class="flex items-center gap-3 p-3 rounded-lg transition-colors hover:bg-opacity-50"
                         style="background-color: var(--color-surface);">
                        {/* Card Image */}
                        <div class="flex-shrink-0 w-12 h-12 rounded-full overflow-hidden"
                             style="background-color: var(--color-bg);">
                          <img src={getCardThumbnail(card.id)}
                               alt={card.name}
                               class="w-full h-full object-cover"
                               loading="lazy" />
                        </div>

                        {/* Card Info */}
                        <div class="flex-1 min-w-0">
                          <div class="font-medium truncate">{card.name}</div>
                          <div class="text-sm text-secondary flex items-center gap-2">
                            <span class="text-yellow-500">{renderStars(card.rarity)}</span>
                            {card.attribute && <span>{card.attribute}</span>}
                            {card.type && <span>• {card.type}</span>}
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </section>
              )}

              {/* Modified Cards Section */}
              {notes.modified_cards.length > 0 && (
                <section>
                  <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full" style="background-color: rgb(59, 130, 246);"></span>
                    Card Changes
                  </h3>
                  <div class="space-y-3">
                    {notes.modified_cards.map((card) => (
                      <div class="p-4 rounded-lg" style="background-color: var(--color-surface);">
                        <div class="flex items-start gap-3">
                          {/* Card Image */}
                          <a href={`/en/cards/${card.id}`} data-card-id={card.id} class="flex-shrink-0">
                            <div class="w-12 h-12 rounded-full overflow-hidden"
                                 style="background-color: var(--color-bg);">
                              <img src={getCardThumbnail(card.id)}
                                   alt={card.name}
                                   class="w-full h-full object-cover"
                                   loading="lazy" />
                            </div>
                          </a>

                          {/* Card Info & Changes */}
                          <div class="flex-1 min-w-0">
                            <a href={`/en/cards/${card.id}`} data-card-id={card.id} class="font-medium link hover:underline">
                              {card.name}
                            </a>
                            <span class="text-yellow-500 text-sm ml-2">{renderStars(card.rarity)}</span>

                            {/* Changes List */}
                            <ul class="mt-2 space-y-1">
                              {card.changes.map((change) => (
                                <li class="text-sm flex items-start gap-2">
                                  <span class="inline-block px-1.5 py-0.5 rounded text-xs font-medium flex-shrink-0"
                                        style={`background-color: ${
                                          change.category === 'stats' ? 'rgba(234, 179, 8, 0.15)' :
                                          change.category === 'skill' ? 'rgba(168, 85, 247, 0.15)' :
                                          change.category === 'ability' ? 'rgba(59, 130, 246, 0.15)' :
                                          change.category === 'acquisition' ? 'rgba(34, 197, 94, 0.15)' :
                                          change.category === 'bond' ? 'rgba(236, 72, 153, 0.15)' :
                                          change.category === 'synergy' ? 'rgba(6, 182, 212, 0.15)' :
                                          change.category === 'meta' ? 'rgba(249, 115, 22, 0.15)' :
                                          'rgba(107, 114, 128, 0.15)'
                                        }; color: ${
                                          change.category === 'stats' ? 'rgb(234, 179, 8)' :
                                          change.category === 'skill' ? 'rgb(168, 85, 247)' :
                                          change.category === 'ability' ? 'rgb(59, 130, 246)' :
                                          change.category === 'acquisition' ? 'rgb(34, 197, 94)' :
                                          change.category === 'bond' ? 'rgb(236, 72, 153)' :
                                          change.category === 'synergy' ? 'rgb(6, 182, 212)' :
                                          change.category === 'meta' ? 'rgb(249, 115, 22)' :
                                          'rgb(156, 163, 175)'
                                        };`}>
                                    {change.category_label}
                                  </span>
                                  <span class="text-secondary">{formatChangeDisplay(change)}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </section>
              )}

                </div>
              </article>
              ))}
            </div>
          </details>
        ))}
      </div>
    )}

    {page.lastPage > 1 && (
      <nav class="mt-8 flex items-center justify-between gap-4" aria-label="Pagination">
        {page.url.prev
          ? <a href={page.url.prev} class="link" rel="prev">&larr; Newer</a>
          : <span></span>}
        <span class="text-secondary text-sm">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next
          ? <a href={page.url.next} class="link" rel="next">Older &rarr;</a>
          : <span></span>}
      </nav>
    )}

    <!-- Card hover popups with mobile modal support -->
    <!-- No card data as props: island props are serialized into this page. -->
    <CardPopups client:load />
  </div>
</BaseLayout>
